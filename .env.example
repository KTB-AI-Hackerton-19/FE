# 브라우저 → Next 서버 → 백엔드 프록시 대상 (서버 전용)
# ngrok 주소는 백엔드를 재기동할 때마다 바뀝니다.
API_PROXY_TARGET=https://customer-faster-stole.ngrok-free.dev

# 비워두면 같은 오리진(프록시)으로 호출합니다.
# 백엔드가 인증 경로의 OPTIONS preflight 를 401 로 막고 있어 현재는 프록시가 필요합니다.
# 백엔드 CORS 가 정리되면 여기에 백엔드 주소를 넣어 직접 호출로 전환하세요.
NEXT_PUBLIC_API_BASE_URL=

# 백엔드에서 만들어준 데모 계정 — ID: demo / PW: demo1234
# 환경변수 테스트
